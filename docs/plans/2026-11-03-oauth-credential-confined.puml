@startuml oauth-credential-confined
' clown#336, candidate B (recommended): the model-API injection proxy. The
' credential never enters the agent unit. Design diagram; nothing here is
' built. [S] spinclass, [C] clown, [K] kernel/systemd, [P] piggy enforce or
' own the element.
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangle {
  RoundCorner 8
}
skinparam ArrowFontSize 12
skinparam nodesep 40
skinparam ranksep 70

rectangle "AGENT UNIT   clown-agent.slice/<unit>.service [K]\nPrivatePIDs  PrivateNetwork (lo only)  ProtectHome=tmpfs\nenv: ANTHROPIC_BASE_URL=http://127.0.0.1:<port>\n     CLAUDE_CODE_OAUTH_TOKEN=<placeholder, not a credential>\n.credentials.json: empty seed, no operator bind" as AU #E8F0FF {
  rectangle "claude + Bash + subagents\n(the worker = the adversary)\nholds only the placeholder" as CLAUDE
  rectangle "agent-relay\n127.0.0.1:<port> -> model.sock" as RELAY
}

rectangle "FRONTEND SCOPE   operator uid, outside the unit" as FE #F4F4F4 {
  rectangle "clown (frontend)\nInjectProxy on model.sock [C]\npeer check: unit cgroup only\nreplaces Authorization, streams,\nlogs method/path/status, never headers" as PROXY
  rectangle "token source [C reads, P writes]\nH1: $XDG_RUNTIME_DIR/piggy/secrets/<entry>\n(tmpfs, 0600, hidden from units)\nH2: in-memory holder in spinclass serve [S]" as SRC
  rectangle "piggy secrets reconcile [P]\ncard-present, one PIN per boot\nebox in circus infra/secrets" as PIGGY
}

cloud "api.anthropic.com:443\n(TLS from the frontend;\nnot on the unit's egress list)" as API

CLAUDE -down-> RELAY : 1 plain HTTP to the base URL
RELAY ..> PROXY : 2 unix socket, bound in
PROXY -right-> API : 3 TLS, real bearer
PROXY -down-> SRC : 4 read per request
PIGGY -right-> SRC : 5 write at a card-present moment
AU -[hidden]down- FE
@enduml
