# clown's burned-in default clownfile (RFC-0013 §1.3).
#
# This file ships in the nix store and is merged as the LOWEST-precedence layer
# of the clownfile cascade: any user `clownfile` discovered ascending $PWD->$HOME
# (and the XDG user-global clownfile, clown#149) overrides these values per key.
# The multiplexer defaults to "none", so clown runs INLINE by default. To opt
# into a multiplexer self-wrap, set `multiplexer = "zmx"` in a user clownfile;
# the start/resume/spawn templates below are then inherited (a non-empty scalar
# replaces this default per key).
#
# The zmx [attach] templates below match spinclass's confirmed real
# [session-entry] defaults where one exists (FDR-0017 Piece 1):
#   - spawn / spawn-entry: equal to spinclass's real defaults.
#   - start / resume: clown-native (spinclass shipped no baked mux template here;
#     clown owns the interactive self-wrap when zmx is opted into).
# They are inert while `multiplexer = "none"` and used only when a user clownfile
# opts into zmx. Placeholders: {id} = the per-instance session key (RFC-0013 §2);
# {group} = the resolved group-id (RFC-0014, title only, falls back to {id} when
# empty); the exact element "{entry}" splices clown's own entrypoint argv.

[attach]
multiplexer  = "none"
# group-id keys the group chat channel, presence grouping, and the {group} resume
# title (RFC-0014 §2). It is sourced by ENV INTERPOLATION: "${SPINCLASS_SESSION_ID}"
# binds to the orchestrator's session key when present, and interpolates to the
# empty string (⇒ ungrouped) for a bare clown — a graceful, lightly-coupled
# default that names the orchestrator var only as a config template, never in
# clown code. Shipping it here (not an eng-root clownfile) makes the cutover
# atomic: the same release that drops the hardcoded SPINCLASS_SESSION_ID read
# also supplies this binding, so there is no no-group window.
group-id     = "${SPINCLASS_SESSION_ID}"
# description is the human-readable presence label (RFC-0014 §4.1), same
# interpolation + graceful-empty contract as group-id.
description  = "${SPINCLASS_DESCRIPTION}"
start        = ["zmx", "attach", "{id}", "{entry}"]
resume       = ["zmx", "attach", "{id}", "{entry}"]
resume-title = "{group}"
spawn        = ["zmx", "attach", "{id}", "--detach", "{entry}"]
spawn-entry  = ["clown", "--", "{prompt}"]
# spawn-window has no default (unset = no window).
# pty-suspend wraps the interactive provider in clown's escape-to-shell pty proxy
# (internal/ptysuspend): clown runs the provider on an inner pty and intercepts
# the escape key BEFORE the raw-mode TUI swallows it, hands the terminal to the
# escape-command, and resumes the provider when it exits. A raw-mode TUI like
# claude does not do this for itself. Works uniformly inline and inside a mux
# pane (clown owns the pane process either way). Default OFF in this phase; opt
# in per-clownfile with `pty-suspend = true`. The burned-in default flips to true
# once dogfooded.
#   escape-key      caret notation, default "^Z".
#   escape-command  argv run with the terminal (each element env-interpolated);
#                   empty falls back to $SHELL in the worktree. Intended default
#                   once spinclass ships `sc exec`:
#                     escape-command = ["sc", "exec", "${SPINCLASS_SESSION_ID}", "$SHELL"]
# pty-suspend = false
