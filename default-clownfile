# clown's burned-in default clownfile (RFC-0013 §1.3).
#
# This file ships in the nix store and is merged as the LOWEST-precedence layer
# of the clownfile cascade: any user `clownfile` discovered ascending $PWD->$HOME
# (and the XDG user-global clownfile, clown#149) overrides these values per key.
# The multiplexer defaults to "posh", so clown self-wraps each interactive
# instance in a posh session by default (a non-interactive run, or one whose
# configured multiplexer is not installed, degrades to INLINE — see
# maybeReexecMultiplexer). To run inline unconditionally, set
# `multiplexer = "none"` in a user clownfile; the start/resume/spawn templates
# below are then inert.
#
# posh (the portable shell: zmx-style local session persistence + mosh-style
# roaming) is the eng-standard session manager — the same substrate spinclass's
# liveness-probe enumerates (eng home/spinclass.nix, substrate = "posh"). clown
# OWNS the attach: spinclass execs clown and clown self-wraps in posh; spinclass
# discovers the live session via clown's presence index (internal/jobwake/
# presence.go, decoration == the group-id), NOT by the posh session name, so
# clown keeps naming the session by its per-instance key (RFC-0013 §2.3).
#
# posh's `attach NAME [cmd...] [--detach]` is a drop-in for the former zmx
# templates: a live NAME reattaches and ignores the command (so one template
# serves both fresh-start and resume), and --detach is recognized anywhere in
# argv (so the spawn template splices it before {entry}). Placeholders:
# {id} = the per-instance session key (RFC-0013 §2), used as the posh session
# NAME; {group} = the resolved group-id (RFC-0014, title only, falls back to
# {id} when empty); the exact element "{entry}" splices clown's own entrypoint
# argv (spliced RAW — local `posh attach` does not strip a leading "--").

[attach]
multiplexer  = "posh"
# group-id keys the group chat channel, presence grouping, and the {group} resume
# title (RFC-0014 §2). It is sourced by ENV INTERPOLATION: "${SPINCLASS_SESSION_ID}"
# binds to the orchestrator's session key when present, and interpolates to the
# empty string (⇒ ungrouped) for a bare clown — a graceful, lightly-coupled
# default that names the orchestrator var only as a config template, never in
# clown code. Shipping it here (not an eng-root clownfile) makes the cutover
# atomic: the same release that drops the hardcoded SPINCLASS_SESSION_ID read
# also supplies this binding, so there is no no-group window.
group-id     = "${SPINCLASS_SESSION_ID}"
# description is the human-readable presence label (RFC-0014 §4.1), same
# interpolation + graceful-empty contract as group-id.
description  = "${SPINCLASS_DESCRIPTION}"
start        = ["posh", "attach", "{id}", "{entry}"]
resume       = ["posh", "attach", "{id}", "{entry}"]
# resume-title is emitted on BOTH a fresh start and a reattach (clown#169;
# previously resume-only). {id} prefers the human-ergonomic clown-name
# (clown#169's mutex-allocated name pool, internal/clownname) over the raw
# per-instance UUID, so under a spinclass session this renders as
# "sc/<repo>/<branch>/<clown-name>" (e.g. "sc/clown/deft-elm/bozo") — the
# literal "sc/" prefix is just a literal string here, not a placeholder; a
# bare clown (empty {group}) falls back to "sc/<clown-name>".
resume-title = "sc/{group}/{id}"
spawn        = ["posh", "attach", "{id}", "--detach", "{entry}"]
spawn-entry  = ["clown", "--", "{prompt}"]
# spawn-window has no default (unset = no window).
# pty-suspend wraps the interactive provider in clown's escape-to-shell pty proxy
# (internal/ptysuspend): clown runs the provider on an inner pty and intercepts
# the escape key BEFORE the raw-mode TUI swallows it, hands the terminal to the
# escape-command, and resumes the provider when it exits. A raw-mode TUI like
# claude does not do this for itself. Works uniformly inline and inside a mux
# pane (clown owns the pane process either way). Default OFF in this phase; opt
# in per-clownfile with `pty-suspend = true`. The burned-in default flips to true
# once dogfooded.
#   escape-key      caret notation, default "^Z".
#   escape-command  argv run with the terminal (each element env-interpolated);
#                   empty falls back to $SHELL in the worktree. Intended default
#                   once spinclass ships `sc exec`:
#                     escape-command = ["sc", "exec", "${SPINCLASS_SESSION_ID}", "$SHELL"]
# pty-suspend = false
